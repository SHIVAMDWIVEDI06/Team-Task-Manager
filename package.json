{
  "name": "teamtask",
  "version": "2.0.0",
  "private": true,
  "description": "TeamTask — a modern, real-time team task manager. Zero runtime dependencies.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --watch --no-warnings=ExperimentalWarning apps/api/src/server.ts",
    "dev:web": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "start": "node --no-warnings=ExperimentalWarning dist/api/server.js",
    "typecheck": "tsc -p apps/api/tsconfig.json && tsc -p apps/web/tsconfig.json",
    "seed": "node --no-warnings=ExperimentalWarning apps/api/src/db/seed.ts",
    "test:e2e": "node --no-warnings=ExperimentalWarning e2e/run.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.27.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
