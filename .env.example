# ---- Server ----
PORT=3000
NODE_ENV=production
# Public URL of the app (used in invite / reset links)
APP_URL=http://localhost:3000
# REQUIRED in production: long random string (openssl rand -hex 32)
JWT_SECRET=change-me-please
# Comma-separated list of allowed origins for CORS (leave empty to allow same-origin only)
CORS_ORIGINS=

# ---- Storage ----
# SQLite file (default: ./data/teamtask.db). On Railway mount a volume at /data and set DATA_DIR=/data
DATA_DIR=./data
# Max upload size in MB
MAX_UPLOAD_MB=25

# ---- Email (optional). Without SMTP, invite & reset links are shown in the UI and logged. ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TeamTask <no-reply@example.com>"
